{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontLaunchNoResourceType",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreatePublicKey",
        "cloudfront:GetPublicKey",
        "cloudfront:GetPublicKeyConfig",
        "cloudfront:UpdatePublicKey",
        "cloudfront:DeletePublicKey",
        "cloudfront:ListPublicKeys",
        "cloudfront:CreateKeyGroup",
        "cloudfront:GetKeyGroup",
        "cloudfront:GetKeyGroupConfig",
        "cloudfront:UpdateKeyGroup",
        "cloudfront:DeleteKeyGroup",
        "cloudfront:ListKeyGroups",
        "cloudfront:CreateFunction",
        "cloudfront:ListFunctions",
        "cloudfront:CreateKeyValueStore",
        "cloudfront:ListKeyValueStores"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontLaunchFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:TestFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:function/cerberus-launch-*"
    },
    {
      "Sid": "CloudFrontLaunchKeyValueStore",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeKeyValueStore",
        "cloudfront:UpdateKeyValueStore",
        "cloudfront:DeleteKeyValueStore",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:ListTagsForResource",
        "cloudfront-keyvaluestore:DescribeKeyValueStore",
        "cloudfront-keyvaluestore:GetKey",
        "cloudfront-keyvaluestore:ListKeys",
        "cloudfront-keyvaluestore:PutKey",
        "cloudfront-keyvaluestore:DeleteKey",
        "cloudfront-keyvaluestore:UpdateKeys"
      ],
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:key-value-store/*"
    },
    {
      "Sid": "CloudFrontLaunchVendedLogs",
      "Effect": "Allow",
      "Action": "cloudfront:AllowVendedLogDeliveryForResource",
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/*"
    },
    {
      "Sid": "LogsDeliveryV2",
      "Effect": "Allow",
      "Action": [
        "logs:PutDeliverySource",
        "logs:GetDeliverySource",
        "logs:DeleteDeliverySource",
        "logs:PutDeliveryDestination",
        "logs:GetDeliveryDestination",
        "logs:DeleteDeliveryDestination",
        "logs:GetDeliveryDestinationPolicy",
        "logs:PutDeliveryDestinationPolicy",
        "logs:DeleteDeliveryDestinationPolicy",
        "logs:CreateDelivery",
        "logs:GetDelivery",
        "logs:DeleteDelivery",
        "logs:UpdateDeliveryConfiguration",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:<ACCOUNT_ID>:delivery-source:cerberus-launch-*",
        "arn:aws:logs:us-east-1:<ACCOUNT_ID>:delivery-destination:cerberus-launch-*",
        "arn:aws:logs:us-east-1:<ACCOUNT_ID>:delivery:*"
      ]
    },
    {
      "Sid": "LogsDeliveryV2Describe",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeDeliveries",
        "logs:DescribeDeliverySources",
        "logs:DescribeDeliveryDestinations",
        "logs:DescribeConfigurationTemplates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetMetricsConfiguration",
        "s3:PutMetricsConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketWebsite",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::cerberus-platform-launch-*"
    },
    {
      "Sid": "LaunchObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::cerberus-platform-launch-*/*"
    },
    {
      "Sid": "LaunchSessionParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:us-east-1:<ACCOUNT_ID>:parameter/cerberus/launch/*"
    },
    {
      "Sid": "SsmAccountRead",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeParameters",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:instance-profile/cerberus-launch-*"
    },
    {
      "Sid": "LaunchRoleExtra",
      "Effect": "Allow",
      "Action": [
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:UpdateRole"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/cerberus-launch-*"
    },
    {
      "Sid": "PassLaunchRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/cerberus-launch-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SpotRequestCancel",
      "Effect": "Allow",
      "Action": "ec2:CancelSpotInstanceRequests",
      "Resource": "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:spot-instances-request/*"
    },
    {
      "Sid": "FreeTierRead",
      "Effect": "Allow",
      "Action": "freetier:GetFreeTierUsage",
      "Resource": "*"
    }
  ]
}
