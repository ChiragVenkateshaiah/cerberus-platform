# The per-session bundle, the readiness probe and live.json.

locals {
  # The boot module and its template, from observability/grafana/console.
  # Tests, conftest, paths.py and stage_artifacts.sh stay out of the bundle.
  console_files = [
    "annotations.py",
    "build.py",
    "dashboards.py",
    "grafana.ini.tmpl",
    "grafana_ini.py",
    "load.py",
  ]

  dashboard_files = fileset("${local.repo_root}/observability/grafana/dashboards", "*.json")
  run_files       = fileset("${local.repo_root}/observability/scale/runs", "*.json")

  # The dashboards provider for the console copy of the dashboards. The path
  # is where user_data.sh.tftpl puts the output of build.py.
  dashboard_provider = <<-EOT
    # Generated by terraform/envs/dev-console (session.tf).
    apiVersion: 1
    providers:
      - name: console
        orgId: 1
        folder: Cerberus
        type: file
        disableDeletion: true
        editable: false
        options:
          path: ${local.dashboards_dir}
  EOT
}

# --- 1. The bundle ------------------------------------------------------------
# Layout (user_data.sh.tftpl unpacks it):
#   console/*          the boot module (build.py, load.py, grafana_ini.py ...)
#   dashboards/*.json  the repo dashboards, as the input of build.py
#   runs/*.json        the run records, ditto
#   provisioning/datasources/amp.yaml   the repo file; ${AMP_URL} is filled in
#                                       on the host (the only datasource)
#   provisioning/dashboards/console.yaml
data "archive_file" "bundle" {
  type             = "zip"
  output_path      = "${path.module}/build/bundle.zip"
  output_file_mode = "0644"

  dynamic "source" {
    for_each = local.console_files
    content {
      content  = file("${local.repo_root}/observability/grafana/console/${source.value}")
      filename = "console/${source.value}"
    }
  }

  dynamic "source" {
    for_each = local.dashboard_files
    content {
      content  = file("${local.repo_root}/observability/grafana/dashboards/${source.value}")
      filename = "dashboards/${source.value}"
    }
  }

  dynamic "source" {
    for_each = local.run_files
    content {
      content  = file("${local.repo_root}/observability/scale/runs/${source.value}")
      filename = "runs/${source.value}"
    }
  }

  source {
    content  = file("${local.repo_root}/observability/grafana/provisioning/datasources/amp.yaml")
    filename = "provisioning/datasources/amp.yaml"
  }

  source {
    content  = local.dashboard_provider
    filename = "provisioning/dashboards/console.yaml"
  }
}

# Destroyed with the session (it is a normal managed object; the artifacts/
# prefix is private, CloudFront is denied it). The sha256 in the key lets the
# boot script check what it downloads.
resource "aws_s3_object" "bundle" {
  bucket       = local.standing.console_site_bucket_name
  key          = "artifacts/session/bundle-${data.archive_file.bundle.output_sha256}.zip"
  source       = data.archive_file.bundle.output_path
  etag         = data.archive_file.bundle.output_md5
  content_type = "application/zip"
}

# --- 2. Readiness probe -------------------------------------------------------
# Polls https://<distribution>/api/health until HTTP 200, at most 20 minutes
# (probe.sh; needs curl on the machine running terraform). Creation needs the
# distribution deployed, the app client in place and the instance past its
# boot script, which opens port 3000 last. A timeout fails the apply, and the
# owner (or the PR E trap) destroys. It runs only on create: a later plan does
# not re-probe.
resource "terraform_data" "probe" {
  triggers_replace = [aws_cloudfront_distribution.this.id]

  provisioner "local-exec" {
    command = "bash ${path.module}/probe.sh"

    environment = {
      URL         = "https://${aws_cloudfront_distribution.this.domain_name}/api/health"
      MAX_SECONDS = "1200"
    }
  }

  depends_on = [
    aws_cognito_user_pool_client.grafana,
    aws_vpc_security_group_ingress_rule.from_cloudfront,
  ]
}

# --- 3. live.json -------------------------------------------------------------
# The live link for the landing page (ADR 0024 L114), written only after the
# probe passes. The site publish never deletes root objects (plan F11).
# After a dead trap this file stays with `ends` in the past: the reader (9.4's
# live.js) must hide it once `ends` has passed. Destroy deletes it first.
resource "time_static" "started" {
  depends_on = [terraform_data.probe]
}

resource "aws_s3_object" "live" {
  bucket        = local.standing.console_site_bucket_name
  key           = "live.json"
  content_type  = "application/json"
  cache_control = "no-cache, max-age=0"

  content = jsonencode({
    schema  = 1
    url     = "https://${aws_cloudfront_distribution.this.domain_name}/"
    home    = "/d/cerberus-runs"
    started = time_static.started.rfc3339
    ends    = local.ends
  })
}
