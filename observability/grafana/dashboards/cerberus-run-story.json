    {
      "id": 9,
      "title": "Cost so far (estimate)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "refId": "S",
          "expr": "(time() - ${__from:date:seconds}) / 3600 * 1.15",
          "legendFormat": "servers",
          "range": false,
          "instant": true,
          "hide": true
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "P0",
          "id": "",
          "hide": true,
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "default",
          "statistic": "Sum",
          "period": "60",
          "label": "Athena bytes",
          "expression": "SUM(SEARCH('{AWS/Athena,WorkGroup} MetricName=\"ProcessedBytes\" (WorkGroup=\"cerberus_platform\" OR WorkGroup=\"cerberus_platform_dq\")', 'Sum', 60))"
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "P",
          "type": "reduce",
          "expression": "P0",
          "reducer": "sum",
          "hide": true,
          "settings": {
            "mode": "replaceNN",
            "replaceWithValue": 0
          }
        },
        {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "refId": "COST",
          "type": "math",
          "expression": "$S + $P / 200000000000"
        }
      ],
      "description": "Estimate: servers = hours since the dashboard start x $1.15 an hour (2026-10-13 run record: $1.207592 non-Athena over 1.048 h of observed cluster time), plus Athena queries = bytes scanned (CloudWatch ProcessedBytes, both workgroups) x $5 per 10^12 bytes. Whether Athena bills per 10^12 or per 2^40 bytes is not verified (docs/scale-metrics.md). The real bill comes a day later.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "COST"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "servers + Athena queries"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 20,
          "valueSize": 44
        }
      }
    },
    {
