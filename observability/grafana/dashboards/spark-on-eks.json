{
  "uid": "cerberus-spark-on-eks",
  "title": "Cerberus: Spark on EKS",
  "tags": [
    "cerberus",
    "spark",
    "eks"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Orchestrated run (CloudWatch)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Step Functions executions",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "ExecutionsStarted"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "B",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsSucceeded",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "ExecutionsSucceeded"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "C",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsFailed",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "ExecutionsFailed"
        }
      ],
      "description": "The cerberus-platform-orchestration state machine, from CloudWatch -- the same metrics the 6.1 dashboard and 6.2 alarms use."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spark Operator: applications",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "{__name__=~\"spark_application_(submit|success|failure)_count\"}",
          "legendFormat": "{{__name__}}",
          "refId": "A",
          "range": true
        }
      ],
      "description": "The Spark Operator controller's own /metrics."
    },
    {
      "id": 4,
      "type": "row",
      "title": "Spark executors (AMP, PrometheusServlet executor summary)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active tasks",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (executor_id) (metrics_executor_activeTasks)",
          "legendFormat": "executor {{executor_id}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Completed tasks / s",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (executor_id) (rate(metrics_executor_completedTasks_total[1m]))",
          "legendFormat": "executor {{executor_id}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
