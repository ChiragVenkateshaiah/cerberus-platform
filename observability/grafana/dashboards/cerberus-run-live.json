{
  "uid": "cerberus-run-live",
  "title": "Cerberus: live run",
  "description": "Large-panel view of a live exercise run, for a 4:5 (about 864x1080) browser window. ADR 0022.",
  "tags": [
    "cerberus",
    "run-live"
  ],
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Spark executors running",
      "description": "Executors that report metrics right now, per Spark application (instant query, so a finished application drops out; the inner max drops duplicate series from a reused pod IP), and executor pods from kube-state-metrics.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "titleSize": 20,
          "valueSize": 64
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "count by (application_name) (max by (application_name, application_id, executor_id) (last_over_time(metrics_executor_activeTasks{executor_id!=\"driver\"}[45s])))",
          "legendFormat": "{{application_name}}",
          "refId": "A",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "count(kube_pod_info{namespace=\"spark-jobs\",pod=~\".*-exec-.*\"})",
          "legendFormat": "executor pods",
          "refId": "B",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Input read so far",
      "description": "Sum over executors of each executor's peak totalInputBytes counter in the dashboard range, per application. Same method as collect_run_metrics.py, so it matches the run record's spark_input_bytes. It undercounts if a transform runs longer than the dashboard range.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0 B"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "titleSize": 20,
          "valueSize": 64
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (application_name) (max by (application_name, application_id, executor_id) (max_over_time(metrics_executor_totalInputBytes_bytes_total[$__range]))) > 0",
          "legendFormat": "{{application_name}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Nodes: On-Demand vs Spot",
      "description": "Nodes by eks.amazonaws.com/capacityType (needs the kube-state-metrics label allowlist, ADR 0022 step 6; empty on older runs) and the total node count from kube_node_info.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SPOT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ON_DEMAND"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "all nodes"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "count by (label_eks_amazonaws_com_capacity_type) (kube_node_labels)",
          "legendFormat": "{{label_eks_amazonaws_com_capacity_type}}",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "count(kube_node_info)",
          "legendFormat": "all nodes",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tasks completed / s",
      "description": "Tasks finished per second, per application, from the Spark executor summary. The inner max removes duplicate series from a reused driver pod IP.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "decimals": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum by (application_name) (max by (application_name, application_id, executor_id) (rate(metrics_executor_completedTasks_total{executor_id!=\"driver\"}[1m])))",
          "legendFormat": "{{application_name}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Input bytes / s",
      "description": "Bytes read per second across all executors.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(max by (application_name, application_id, executor_id) (rate(metrics_executor_totalInputBytes_bytes_total[1m])))",
          "legendFormat": "input",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node CPU busy",
      "description": "CPU busy share across nodes: the average and the busiest node.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 3,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "avg(1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "average",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "max(1 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "busiest node",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Step Functions executions",
      "description": "The cerberus-platform-orchestration state machine, from CloudWatch (sum over the dashboard range).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Succeeded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "wideLayout": true,
        "text": {
          "titleSize": 20,
          "valueSize": 56
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "A",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "Started"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "B",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsSucceeded",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "Succeeded"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "refId": "C",
          "queryMode": "Metrics",
          "region": "default",
          "namespace": "AWS/States",
          "metricName": "ExecutionsFailed",
          "dimensions": {
            "StateMachineArn": "arn:aws:states:us-east-1:131715059025:stateMachine:cerberus-platform-orchestration"
          },
          "statistic": "Sum",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "id": "",
          "expression": "",
          "label": "Failed"
        }
      ]
    }
  ]
}
