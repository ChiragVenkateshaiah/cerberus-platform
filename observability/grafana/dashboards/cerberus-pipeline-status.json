{
  "uid": "cerberus-pipeline-status",
  "title": "4 \u00b7 Pipeline Status: did the last run pass?",
  "tags": [
    "cerberus",
    "status"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "",
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "description": "Did the last run pass, what broke if it did not, and how the recent runs went. Written for everyone: no query language needed.",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "hide": true,
        "name": "Annotations & Alerts",
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now, in plain words",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Last run",
      "type": "stat",
      "description": "Did the newest run pass? Green means it finished well. Red means it failed.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "last_over_time(cerberus_run_status[30d])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Passed",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Failed",
                  "color": "red",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No run yet",
                  "color": "text",
                  "index": 9
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "No run yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 16,
          "valueSize": 32
        }
      }
    },
    {
      "id": 3,
      "title": "What broke",
      "type": "stat",
      "description": "The step that stopped the newest run. It says nothing broke when the last run passed.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "(last_over_time(cerberus_run_step_failed[30d]) == 1)",
          "legendFormat": "{{step}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "failed here",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Nothing, the last run passed",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 16,
          "valueSize": 32
        }
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^InvokeIngestion$",
            "renamePattern": "1 \u00b7 Receive payments"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^RunTransform$",
            "renamePattern": "2 \u00b7 Clean and merge (Spark)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^RunDbt$",
            "renamePattern": "3 \u00b7 Build reports (dbt)"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^RunServingQuery$",
            "renamePattern": "4 \u00b7 Answer the demo query"
          }
        }
      ]
    },
    {
