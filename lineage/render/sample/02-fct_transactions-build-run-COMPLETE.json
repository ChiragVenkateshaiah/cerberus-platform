{"eventTime": "2026-09-07T07:22:07.291689Z", "eventType": "COMPLETE", "inputs": [{"facets": {"dataSource": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-0-1/DatasourceDatasetFacet.json#/$defs/DatasourceDatasetFacet", "name": "awsathena://athena.us-east-1.amazonaws.com", "uri": "awsathena://athena.us-east-1.amazonaws.com"}, "documentation": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-1-0/DocumentationDatasetFacet.json#/$defs/DocumentationDatasetFacet", "description": "Silver event stream, one row per payment lifecycle event (created/authorized/settled/failed/refunded) -- see ADR 0003 and the 1.7 transform. The marts below resolve this down to current-state rows.\n"}, "schema": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-2-0/SchemaDatasetFacet.json#/$defs/SchemaDatasetFacet", "fields": [{"description": "", "fields": [], "name": "transaction_id"}, {"description": "", "fields": [], "name": "event_timestamp"}, {"description": "", "fields": [], "name": "event_type"}, {"description": "", "fields": [], "name": "amount"}, {"description": "", "fields": [], "name": "currency"}]}, "symlinks": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-0-1/SymlinksDatasetFacet.json#/$defs/SymlinksDatasetFacet", "identifiers": [{"name": "table/cerberus_platform/payments_events", "namespace": "arn:aws:glue:us-east-1:131715059025", "type": "TABLE"}]}}, "name": "awsdatacatalog.cerberus_platform.payments_events", "namespace": "awsathena://athena.us-east-1.amazonaws.com"}], "job": {"facets": {"dbt_node": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://github.com/OpenLineage/OpenLineage/tree/main/integration/common/openlineage/schema/dbt-node-job-facet.json", "alias": "fct_transactions", "database": "awsdatacatalog", "original_file_path": "models/marts/fct_transactions.sql", "schema": "cerberus_platform", "unique_id": "model.cerberus_platform.fct_transactions"}, "jobType": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/integration/dbt", "_schemaURL": "https://openlineage.io/spec/facets/2-0-4/JobTypeJobFacet.json#/$defs/JobTypeJobFacet", "integration": "DBT", "jobType": "MODEL", "processingType": "BATCH"}, "sql": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-1-0/SQLJobFacet.json#/$defs/SQLJobFacet", "dialect": "athena", "query": "-- Latest-event-wins per transaction_id, same resolution 1.7's Python/pandas\n-- transform uses for payments_current -- expressed here in SQL, emitting\n-- merchant_id/customer_id as foreign keys into dim_merchants/dim_customers\n-- instead of embedding name/category/email inline. This is the fact/\n-- dimension split ADR 0003 assigned to 1.9.\nwith ranked as (\n    select\n        *,\n        -- event_timestamp alone can tie: generate_payments.py clamps every\n        -- event to min(ts, now), so a settled event and a later refund can\n        -- both land on \"now\" with identical timestamps. This fixed\n        -- lifecycle order breaks the tie the same way promote_payments.py's\n        -- EVENT_TYPE_RANK does (settled/failed share a rank -- only one\n        -- ever occurs per transaction).\n        row_number() over (\n            partition by transaction_id\n            order by\n                event_timestamp desc,\n                case event_type\n                    when 'refunded' then 3\n                    when 'settled' then 2\n                    when 'failed' then 2\n                    when 'authorized' then 1\n                    when 'created' then 0\n                end desc\n        ) as rn\n    from \"awsdatacatalog\".\"cerberus_platform\".\"payments_events\"\n)\n\nselect\n    transaction_id,\n    event_type as status,\n    event_timestamp as last_event_at,\n    amount,\n    currency,\n    merchant_id,\n    customer_id,\n    payment_method_type,\n    payment_method_brand,\n    payment_method_last4,\n    payment_method_token\nfrom ranked\nwhere rn = 1"}}, "name": "awsdatacatalog.cerberus_platform.cerberus_platform.fct_transactions.build.run", "namespace": "cerberus-platform"}, "outputs": [{"facets": {"columnLineage": {"_producer": "https://github.com/OpenLineage/OpenLineage/tree/1.53.0/client/python", "_schemaURL": "https://openlineage.io/spec/facets/1-2-0/ColumnLineageDatasetFacet.json#/$defs/ColumnLineageDatasetFacet", "dataset": [], "fields": {"amount": {"inputFields": [{"field": "amount", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "currency": {"inputFields": [{"field": "currency", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "customer_id": {"inputFields": [{"field": "customer_id", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "last_event_at": {"inputFields": [{"field": "event_timestamp", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "merchant_id": {"inputFields": [{"field": "merchant_id", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "payment_method_brand": {"inputFields": [{"field": "payment_method_brand", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "payment_method_last4": {"inputFields": [{"field": "payment_method_last4", "name": "ranked", "namespace": "awsathena://athena.us-east-1.amazonaws.com", "transformations": []}]}, "payment_method_token": {"inputFields": [{"field": "payment_method_t